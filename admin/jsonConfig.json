          "sm": 6,
          "newLine": true
        },
        "wbOnDelay": {
          "type": "number",
          "label": "Start after (s) with enough surplus",
          "default": 60,
          "min": 0,
          "max": 3600,
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "wbOffDelay": {
          "type": "number",
          "label": "Pause after (s) without surplus",
          "default": 300,
          "min": 0,
          "max": 3600,
          "xs": 12,
          "sm": 4
        },
        "wbImport": {
          "type": "number",
          "label": "Grid import allowed while charging (W)",
          "help": "keeps the minimum current during short clouds",
          "default": 0,
          "min": 0,
          "max": 20000,
          "xs": 12,
          "sm": 4
        },
        "wbSocMin": {
          "type": "number",
          "label": "Battery first up to (%)",
          "help": "below this charge level the home battery charges first; 0 = car first",
          "default": 0,
          "min": 0,
          "max": 100,
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "peakHeader": {
          "type": "header",
          "text": "Heat pump and power peaks",
          "size": 4
        },
        "peakHelp": {
          "type": "staticText",
          "text": "For grid tariffs that charge the highest power: the heat pump goes first, and the grid import incl. the car can be limited. If the car would otherwise not reach the target by the ready time, both run - the car with the minimum current.",
          "xs": 12
        },
        "wbHp": {
          "type": "objectId",
          "label": "Heat pump (data point)",
          "help": "empty = off",
          "xs": 12,
          "sm": 6,
          "newLine": true
        },
        "wbHpKind": {
          "type": "select",
          "label": "Kind of data point",
          "options": [
            {
              "value": "auto",
              "label": "on/off (true/false)"
            },
            {
              "value": "power",
              "label": "power"
            },
            {
              "value": "status",
              "label": "status (off at certain values)"
            }
          ],
          "default": "auto",
          "xs": 12,
          "sm": 3
        },
        "wbHpOff": {
          "type": "text",
          "label": "Off at values",
          "help": "numbers or texts, separated by ; - e.g. Ochsner \"Wärmeerzeuger Status\": 0;3;8 (Standby, extern gesperrt, Störung)",
          "default": "0",
          "hidden": "data.wbHpKind !== 'status'",
          "xs": 12,
          "sm": 6,
          "newLine": true
        },
        "wbHpOn": {
          "type": "number",
          "label": "Runs above (W)",
          "help": "only for a power data point",
          "default": 200,
          "min": 0,
          "max": 50000,
          "xs": 6,
          "sm": 3,
          "hidden": "data.wbHpKind === 'status'",
          "newLine": true
        },
        "wbHpAction": {
          "type": "select",
          "label": "While it runs",
          "options": [
            {
              "value": "pause",
              "label": "pause the car"
            },
            {
              "value": "min",
              "label": "car with minimum current"
            },
            {
              "value": "none",
              "label": "nothing"
            }
          ],
          "default": "pause",
          "xs": 6,
          "sm": 3
        },
        "wbPeak": {
          "type": "number",
          "label": "Grid import at most (kW, incl. car)",
          "help": "0 = no limit",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 0.1,
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "readyHeader": {
          "type": "header",
          "text": "Ready by (optional)",
          "size": 4
        },
        "wbCarSoc": {
          "type": "objectId",
          "label": "Charge level of the car (%)",
          "help": "e.g. from the VW adapter; empty = heat pump and limit always win",
          "xs": 12,
          "sm": 6,
          "newLine": true
        },
        "wbCarSocScale": {
          "type": "number",
          "label": "Factor",
          "help": "e.g. 0.1 when the car reports 212 for 21.2 % - check energie.0.wallbox.carSoc against the app",
          "default": 1,
          "xs": 6,
          "sm": 2
        },
        "wbCapacity": {
          "type": "number",
          "label": "Car battery (kWh)",
          "default": 77,
          "min": 1,
          "max": 200,
          "xs": 6,
          "sm": 2
        },
        "wbTarget": {
          "type": "number",
          "label": "Target (%)",
          "default": 80,
          "min": 1,
          "max": 100,
          "xs": 6,
          "sm": 2
        },
        "wbReady": {
          "type": "text",
          "label": "Ready by (HH:MM)",
          "help": "e.g. 07:00, empty = off",
          "default": "",
          "xs": 6,
          "sm": 2
        }
      }
    },
