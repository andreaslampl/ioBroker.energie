{
  "i18n": true,
  "type": "tabs",
  "items": {
    "_source": {
      "type": "panel",
      "label": "PV & grid",
      "items": {
        "pvHelp": {
          "type": "staticText",
          "text": "Works with every inverter: pick the data points of any adapter (Modbus, SMA, Fronius, Huawei, KNX, …). Watt or kilowatt is taken from the object; for raw Modbus registers set a factor and the sign. Check the result on the page /check (address in info.url, /flow replaced by /check).",
          "xs": 12
        },
        "pvHeader": {
          "type": "header",
          "text": "PV",
          "size": 4,
          "newLine": true
        },
        "pvState": {
          "type": "objectId",
          "label": "PV power (inverter)",
          "xs": 12,
          "sm": 5,
          "newLine": true
        },
        "pvUnit": {
          "type": "select",
          "label": "Unit",
          "options": [
            {
              "value": "auto",
              "label": "automatic (W, kW from the object)"
            },
            {
              "value": "W",
              "label": "W"
            },
            {
              "value": "kW",
              "label": "kW"
            }
          ],
          "default": "auto",
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "pvScale": {
          "type": "number",
          "label": "Factor",
          "default": 1,
          "help": "e.g. 0.1 or 10 (Modbus)",
          "xs": 6,
          "sm": 3
        },
        "pvSigned": {
          "type": "select",
          "label": "Sign",
          "options": [
            {
              "value": "",
              "label": "normal"
            },
            {
              "value": "16",
              "label": "signed 16 bit (Modbus)"
            },
            {
              "value": "32",
              "label": "signed 32 bit (Modbus)"
            }
          ],
          "default": "",
          "xs": 6,
          "sm": 5
        },
        "pvInvert": {
          "type": "checkbox",
          "label": "inverted (negative becomes positive)",
          "xs": 12,
          "newLine": true
        },
        "pvMore": {
          "type": "table",
          "label": "More inverters / strings (optional, add a row with +)",
          "newLine": true,
          "xs": 12,
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "18%"
            },
            {
              "type": "objectId",
              "attr": "state",
              "title": "Data point (power)",
              "width": "30%"
            },
            {
              "type": "select",
              "attr": "unit",
              "title": "Unit",
              "options": [
                {
                  "value": "auto",
                  "label": "automatic (W, kW from the object)"
                },
                {
                  "value": "W",
                  "label": "W"
                },
                {
                  "value": "kW",
                  "label": "kW"
                }
              ],
              "default": "auto",
              "width": "12%"
            },
            {
              "type": "number",
              "attr": "scale",
              "title": "Factor",
              "default": 1,
              "width": "8%"
            },
            {
              "type": "select",
              "attr": "signed",
              "title": "Sign",
              "options": [
                {
                  "value": "",
                  "label": "normal"
                },
                {
                  "value": "16",
                  "label": "signed 16 bit (Modbus)"
                },
                {
                  "value": "32",
                  "label": "signed 32 bit (Modbus)"
                }
              ],
              "default": "",
              "width": "12%"
            },
            {
              "type": "checkbox",
              "attr": "invert",
              "title": "inverted",
              "width": "6%"
            }
          ]
        },
        "gridHeader": {
          "type": "header",
          "text": "Grid",
          "size": 4,
          "newLine": true
        },
        "gridMode": {
          "type": "select",
          "label": "Grid values",
          "options": [
            {
              "value": "single",
              "label": "one data point (+/-)"
            },
            {
              "value": "split",
              "label": "import and export separately"
            }
          ],
          "default": "single",
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "gridState": {
          "type": "objectId",
          "label": "Grid power",
          "hidden": "data.gridMode === 'split'",
          "xs": 12,
          "sm": 5
        },
        "gridPositive": {
          "type": "select",
          "label": "Positive means",
          "options": [
            {
              "value": "import",
              "label": "import"
            },
            {
              "value": "export",
              "label": "export"
            }
          ],
          "default": "import",
          "hidden": "data.gridMode === 'split'",
          "xs": 12,
          "sm": 3
        },
        "gridImport": {
          "type": "objectId",
          "label": "Grid import",
          "hidden": "data.gridMode !== 'split'",
          "xs": 12,
          "sm": 4
        },
        "gridExport": {
          "type": "objectId",
          "label": "Grid export",
          "hidden": "data.gridMode !== 'split'",
          "xs": 12,
          "sm": 4
        },
        "gridUnit": {
          "type": "select",
          "label": "Unit",
          "options": [
            {
              "value": "auto",
              "label": "automatic (W, kW from the object)"
            },
            {
              "value": "W",
              "label": "W"
            },
            {
              "value": "kW",
              "label": "kW"
            }
          ],
          "default": "auto",
          "xs": 12,
          "sm": 4,
          "newLine": true
        },
        "gridScale": {
          "type": "number",
          "label": "Factor",
          "default": 1,
          "help": "e.g. 0.1 or 10 (Modbus)",
          "xs": 6,
          "sm": 3
        },
        "gridSigned": {
          "type": "select",
          "label": "Sign",
          "options": [
            {
              "value": "",
              "label": "normal"
            },
            {
              "value": "16",
              "label": "signed 16 bit (Modbus)"
            },
            {
              "value": "32",
              "label": "signed 32 bit (Modbus)"
            }
          ],
          "default": "",
          "xs": 6,
          "sm": 5
        },
        "gridInvert": {
          "type": "checkbox",
          "label": "inverted (negative becomes positive)",
          "xs": 12,
          "newLine": true,
          "hidden": "data.gridMode === 'split'"
        }
      }
    },
    "_battery": {
